{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/py-check.sh",
            "args": [],
            "if": "Edit(**/*.py)",
            "timeout": 60,
            "statusMessage": "ruff"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/py-check.sh",
            "args": [],
            "if": "Write(**/*.py)",
            "timeout": 60,
            "statusMessage": "ruff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/py-typecheck.sh",
            "args": [],
            "timeout": 180,
            "statusMessage": "ty"
          }
        ]
      }
    ]
  }
}
