# Supply-chain controls. See the frontend section of documentation/frontend/.
#
# min-release-age quarantines freshly published versions: npm builds the tree
# from versions that were available more than this many days ago. The unit is
# days, and it is mutually exclusive with `before`. This is the mitigation for
# registry worms, which are typically detected and yanked within days.
#
# ignore-scripts is the stronger of the two: `postinstall` is the actual
# execution vector for those compromises, while min-release-age only narrows
# the window in which one reaches us. Vite, Rollup and esbuild ship platform
# binaries as optionalDependencies rather than install scripts, so the toolchain
# builds without them. If a dependency ever genuinely needs its script, run that
# one explicitly — do not re-enable scripts globally.
#
# save-exact keeps `^` ranges out of package.json, so the lockfile is the only
# thing that decides versions and an unreviewed transitive bump cannot arrive.
min-release-age=14
ignore-scripts=true
save-exact=true
audit-level=moderate
fund=false
