# How much every process in this repo says about what it is doing. One of
# DEBUG, INFO, WARNING, ERROR, CRITICAL, case-insensitive; anything else refuses
# to start rather than quietly serving a level nobody asked for.
#
# INFO gives the API one line when a request arrives and one when it finishes,
# the second carrying status, duration and what the route actually did. DEBUG
# adds each step inside it — search arms, agent tool calls, session lookups —
# with user text truncated to a preview. Full prompts and responses are never
# logged at any level; they live in the trace files (see LLM_TRACE_* below and
# documentation/logging.md).
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overklagan

# Integration tests only, and never the same database as DATABASE_URL — the
# suite truncates every table before each test. Defaults to DATABASE_URL's
# database name plus "_test", so the usual setup is one `createdb overklagan_test`
# and no entry here at all.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overklagan_test

# Storage. The root every stored key hangs off — PDFs land in
# ./data/documents/, LLM traces in ./data/llm-traces/. Matches the default in
# shared.config, and ./data is what .gitignore covers.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data
GCS_BUCKET=

# Queue
QUEUE_BACKEND=sync
PUBSUB_PROJECT_ID=

# AI — which model and provider each task uses lives in llm_config.yaml, not here.
# See documentation/reference/llm-config.md. Only secrets are required below.
#
# These names are not special to the code: each provider entry in llm_config.yaml
# names the variable its key comes from via `api_key_env`, and the loader reads
# whatever it names. Rename a provider's api_key_env and rename it here to match.
BERGET_API_KEY=
GEMINI_API_KEY=

# Must match `embedding.dimension` in llm_config.yaml and the chunks.embedding
# column width. verify_embedding_dimension() refuses to start if they disagree.
EMBEDDING_DIMENSION=1024

# The local embedding provider loads intfloat/multilingual-e5-large from the
# HuggingFace cache. Even fully cached, sentence-transformers revalidates every
# file against huggingface.co on load, and on WSL those probes hit the 10s
# HF_HUB_ETAG_TIMEOUT one after another — ~90s of silence before the API serves
# its first request, which reads as a hang. Offline mode skips the revalidation:
# startup drops to ~9s. The cost is that a missing file now raises
# LocalEntryNotFoundError instead of being downloaded, so unset this (or run one
# command without it) after changing the embedding model.
HF_HUB_OFFLINE=1

# Search relevance floor — cosine similarity a chunk must reach before the vector
# arm of /api/search will return it. Deliberately here rather than buried in
# api/config.py: it is the parameter that decides what counts as "no match", and
# it is corpus- and model-specific enough to need tuning per environment.
#
# Nothing enforces agreement with the embedding model above, so this is the one
# to re-measure when that changes. Calibrated for multilingual-e5-large with the
# `query: `/`passage: ` prefix pair, whose similarities sit in a compressed high
# band — top-hit similarity by query kind:
#
#   gibberish and off-domain prose        0.70-0.77
#   adjacent legal domains                0.79-0.80
#   real questions about this corpus      0.81-0.89
#
# Lower it to widen recall at the cost of returning nearest-but-unrelated text;
# raise it to demand closer matches at the cost of emptying short queries, which
# the unfloored text arm answers anyway. Set to 0 to disable the floor entirely
# and restore the old behaviour: every query returns a full page of neighbours.
# See documentation/retrieval/deterministic-search.md#the-similarity-floor.
SEARCH_MIN_VECTOR_SIMILARITY=0.78

# --- Overrides. Everything below is optional and beats llm_config.yaml. ---
# Leave them unset unless you mean to override the file; a stale value here
# silently wins over the file and is a common source of confusion.
#
# LLM_PROVIDER is process-wide and flattens EVERY role onto one host, defeating
# per-role providers. `ai` logs a warning when it masks a role's declared choice.
# Valid values are the provider *kinds*, not the names llm_config.yaml gives its
# hosts: openai_compatible, gemini, none. Anything else is rejected at startup.
# LLM_PROVIDER=gemini
#
# `none` is the LLM off switch: every role resolves to a provider that needs no
# key and raises LLMDisabledError if anything calls it, so crawl/download/parse/
# metadata/extract run with no credentials configured. Chunk is where that stops.
# LLM_PROVIDER=none
#
# Per-role model, named after the role: LLM_MODEL_<ROLE>. One per role declared
# in llm_config.yaml — the name is built from the role, so adding a role there
# gives it an override here with no code change.
# LLM_MODEL_STRUCTURED=
# LLM_MODEL_SUMMARIZE=
# LLM_MODEL_CHAT=
# LLM_MODEL_READ=
# LLM_MODEL_SQL=
#
# LLM_MODEL (singular) pre-dates per-task roles and is deliberately ignored by
# them; it would otherwise collapse every role onto one model.
#
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=
#
# LLM_BASE_URL and LLM_API_KEY are the host-agnostic pair. Normally both come
# from the provider entry in llm_config.yaml (`base_url` and `api_key_env`);
# set them here only to point every role at one host by hand. There is no
# built-in default base URL — a provider with neither refuses to start.
# LLM_BASE_URL=
# LLM_API_KEY=
#
# EMBEDDING_PROVIDER is a kind too: openai_compatible, or local to run
# sentence-transformers in-process with no key and no network.
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
#
# Point at a different config file (default: llm_config.yaml, found by walking
# up from the working directory).
# LLM_CONFIG_PATH=

# Development only. Makes POST /api/chat replay a canned event sequence instead
# of running the agent, so agent mode can be looked at without a model call or a
# minute of waiting. Everything else about the request stays real: the SSE
# framing, the session row, the persisted turn, the conversation rail.
#
#   auto      pick per turn — a message of three words or fewer plays the short
#             conversational script, anything longer the slow research one
#   research  always the slow one (~20 s, seven steps, sql evidence, 3 sources)
#   direct    always the short one (~1.5 s, one step, no sources)
#   error     a mid-stream failure — no `done` follows it
#   off       the real agent (the default)
#
# The answers say in their own first sentence that they are fabricated, and the
# fake sources' pdf_url will 404. See documentation/playbooks/live-testing.md.
# CHAT_SCRIPT=auto

# LLM trace capture — see documentation/observability.md.
# One file per billed call, under
# {LOCAL_STORAGE_PATH}/{LLM_TRACE_KEY_PREFIX}/{date}/{interaction_id}/, so one
# directory holds everything a single request cost. Records carry model +
# tokens, never a cost.
LLM_TRACE_ENABLED=true
LLM_TRACE_KEY_PREFIX=llm-traces
# Ask the provider for token usage on streamed responses. Configured under
# `defaults.stream_usage` in llm_config.yaml; set here only to override it.
# LLM_STREAM_USAGE=true

# Crawl worker (Svenska kyrkan OData v4 API)
# Required. Client-side key used by the public svenskakyrkan.se decision search; read it
# from the site's own network requests. Kept out of source so it can be rotated or
# replaced per environment without a code change.
CRAWL_API_KEY=
CRAWL_YEARS=current
CRAWL_API_BASE=https://www.svenskakyrkan.se/webapi/api-v3/odata/
CRAWL_DOCUMENT_URL_TEMPLATE=https://www.svenskakyrkan.se/default.aspx?id={document_id}&ptid=
CRAWL_WEB_ID=1374643
CRAWL_PAGE_SIZE=100
CRAWL_RATE_LIMIT_DELAY=0.5
CRAWL_MAX_RETRIES=3
CRAWL_REQUEST_TIMEOUT=30
CRAWL_TOPIC=download

# Download worker
DOWNLOAD_REQUEST_TIMEOUT=60
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RATE_LIMIT_DELAY=0.5

# Optional services. Nothing in the codebase reads either of these — they pair
# with the optional MinIO and Redis services in docker-compose.yml, which no
# code path uses yet. Storage goes through STORAGE_BACKEND above and the queue
# through QUEUE_BACKEND. Kept as the addresses those services would be reached
# at if either is ever wired up.
MINIO_ENDPOINT=http://localhost:9000
REDIS_URL=redis://localhost:6379
