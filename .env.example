# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overklagan

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/pdfs
GCS_BUCKET=

# Queue
QUEUE_BACKEND=sync
PUBSUB_PROJECT_ID=

# AI — "berget" is the default provider (OpenAI-compatible, https://api.berget.ai/v1).
# "gemini" is fully supported: set LLM_PROVIDER=gemini, GEMINI_API_KEY, and override all
# three LLM_MODEL_* vars with live Gemini names (gemini-2.0-flash was shut down
# 2026-06-01 — see documentation/reference/llm-pricing.md).
LLM_PROVIDER=berget
BERGET_API_KEY=
LLM_BASE_URL=
GEMINI_API_KEY=

# Per-task model assignment (see documentation/packages/ai.md).
LLM_MODEL_STRUCTURED=mistralai/Mistral-Small-3.2-24B-Instruct-2506
LLM_MODEL_SUMMARIZE=mistralai/Mistral-Medium-3.5-128B
LLM_MODEL_CHAT=zai-org/GLM-5.2

# "berget" hosts the same model as "local"; "local" runs sentence-transformers
# in-process — no API key, no network access.
EMBEDDING_PROVIDER=berget
# Passed verbatim to the provider (Berget model id, or SentenceTransformer() for "local")
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Must match the model's output width (e5-large=1024, e5-base=768)
EMBEDDING_DIMENSION=1024

# LLM trace capture — see documentation/observability.md.
# Traces land under {LOCAL_STORAGE_PATH}/{LLM_TRACE_KEY_PREFIX}/{date}.jsonl.
LLM_TRACE_ENABLED=true
LLM_TRACE_KEY_PREFIX=llm-traces
LLM_TRACE_QUEUE_SIZE=1000
LLM_TRACE_FLUSH_TIMEOUT=5.0
# Ask the provider for token usage on streamed responses. Turn off only if a host
# rejects the parameter — it fails the whole call, and streaming is the chat path.
LLM_STREAM_USAGE=true

# Crawl worker (Svenska kyrkan OData v4 API)
# Required. Client-side key used by the public svenskakyrkan.se decision search; read it
# from the site's own network requests. Kept out of source so it can be rotated or
# replaced per environment without a code change.
CRAWL_API_KEY=
CRAWL_YEARS=current
CRAWL_API_BASE=https://www.svenskakyrkan.se/webapi/api-v3/odata/
CRAWL_DOCUMENT_URL_TEMPLATE=https://www.svenskakyrkan.se/default.aspx?id={document_id}&ptid=
CRAWL_WEB_ID=1374643
CRAWL_PAGE_SIZE=100
CRAWL_RATE_LIMIT_DELAY=0.5
CRAWL_MAX_RETRIES=3
CRAWL_REQUEST_TIMEOUT=30
CRAWL_TOPIC=download

# Download worker
DOWNLOAD_REQUEST_TIMEOUT=60
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RATE_LIMIT_DELAY=0.5

# Optional services
MINIO_ENDPOINT=http://localhost:9000
REDIS_URL=redis://localhost:6379
