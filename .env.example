# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/overklagan

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/pdfs
GCS_BUCKET=

# Queue
QUEUE_BACKEND=sync
PUBSUB_PROJECT_ID=

# AI
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=e5-multilingual

# Crawl worker
CRAWL_SOURCE_URL=https://example.com/decisions
CRAWL_REQUEST_TIMEOUT=30
CRAWL_TOPIC=download

# Download worker
DOWNLOAD_REQUEST_TIMEOUT=60
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RATE_LIMIT_DELAY=0.5

# Optional services
MINIO_ENDPOINT=http://localhost:9000
REDIS_URL=redis://localhost:6379
